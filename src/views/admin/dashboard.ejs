<%- include('../partials/header') %>

<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
  <div>
    <h1 style="font-size: 1.85rem; font-weight: 700;">Platform Security & Admin Control</h1>
    <p style="color: var(--text-muted); font-size: 0.95rem;">High-privilege console: monitoring users, products, orders, and security events.</p>
  </div>
  <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
    <a href="/admin/users" class="btn btn-secondary btn-sm">👥 Users</a>
    <a href="/admin/products" class="btn btn-secondary btn-sm">📦 Products</a>
    <a href="/admin/orders" class="btn btn-secondary btn-sm">💳 Orders</a>
    <a href="/admin/logs" class="btn btn-primary btn-sm">🛡️ Audit Logs</a>
  </div>
</div>

<!-- KPI Stats Grid -->
<div class="stats-grid">
  <div class="stat-card">
    <div class="stat-title">Customers</div>
    <div class="stat-value"><%= metrics.totalUsers %></div>
  </div>
  <div class="stat-card">
    <div class="stat-title">Registered Vendors</div>
    <div class="stat-value"><%= metrics.totalVendors %></div>
  </div>
  <div class="stat-card">
    <div class="stat-title">Marketplace Products</div>
    <div class="stat-value"><%= metrics.totalProducts %></div>
  </div>
  <div class="stat-card">
    <div class="stat-title">Total Orders</div>
    <div class="stat-value"><%= metrics.totalOrders %></div>
  </div>
  <div class="stat-card">
    <div class="stat-title">Gross Volume</div>
    <div class="stat-value" style="color: var(--accent);">$<%= metrics.totalRevenue %></div>
  </div>
</div>

<!-- Recent Security Audit Events -->
<div style="display: flex; justify-content: space-between; align-items: baseline; margin-top: 2rem; margin-bottom: 0.75rem;">
  <h2 style="font-size: 1.25rem; font-weight: 700;">Real-Time Security Audit Stream</h2>
  <a href="/admin/logs" style="font-size: 0.85rem;">View all 100+ events →</a>
</div>

<div class="table-responsive">
  <table>
    <thead>
      <tr>
        <th>Timestamp</th>
        <th>Action Event</th>
        <th>Subject User</th>
        <th>Client IP</th>
        <th>Security Details</th>
      </tr>
    </thead>
    <tbody>
      <% recentLogs.forEach(log => { %>
        <tr>
          <td style="font-family: monospace; font-size: 0.8rem; color: var(--text-muted);">
            <%= new Date(log.created_at).toISOString().replace('T', ' ').substring(0, 19) %>
          </td>
          <td>
            <span class="badge" style="background-color: #e2e8f0; color: #1e293b; font-family: monospace;">
              <%= log.action %>
            </span>
          </td>
          <td><%= log.user_email || 'System / Unauth' %></td>
          <td style="font-family: monospace; font-size: 0.8rem;"><%= log.ip_address %></td>
          <td style="font-size: 0.85rem; color: #475569;"><%= log.details %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<%- include('../partials/footer') %>
