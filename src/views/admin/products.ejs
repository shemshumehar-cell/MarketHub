<%- include('../partials/header') %>

<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
  <div>
    <h1 style="font-size: 1.75rem; font-weight: 700;">Marketplace Product Moderation</h1>
    <p style="color: var(--text-muted); font-size: 0.95rem;">Review and moderate product listings from all registered merchants.</p>
  </div>
  <a href="/admin" class="btn btn-secondary">← Back to Admin Console</a>
</div>

<div class="table-responsive">
  <table>
    <thead>
      <tr>
        <th>ID</th>
        <th>Product</th>
        <th>Vendor</th>
        <th>Category</th>
        <th>Price</th>
        <th>Stock</th>
        <th>Status</th>
        <th>Moderation Action</th>
      </tr>
    </thead>
    <tbody>
      <% products.forEach(prod => { %>
        <tr>
          <td>#<%= prod.id %></td>
          <td>
            <div style="display: flex; align-items: center; gap: 0.75rem;">
              <img src="<%= prod.image_url || '/images/placeholder.svg' %>" alt="<%= prod.title %>" style="width: 40px; height: 40px; object-fit: cover; border-radius: 4px; background: #f1f5f9;">
              <div>
                <a href="/products/<%= prod.id %>" style="font-weight: 600; color: var(--secondary);">
                  <%= prod.title %>
                </a>
              </div>
            </div>
          </td>
          <td>
            <div style="font-weight: 500;"><%= prod.vendor_name %></div>
            <div style="font-size: 0.75rem; color: var(--text-muted);"><%= prod.vendor_email %></div>
          </td>
          <td><%= prod.category_name || 'General' %></td>
          <td style="font-weight: 700;">$<%= Number(prod.price).toFixed(2) %></td>
          <td><%= prod.stock %> units</td>
          <td>
            <span class="badge badge-<%= prod.status %>"><%= prod.status %></span>
          </td>
          <td>
            <form action="/admin/products/<%= prod.id %>/status" method="POST" style="margin: 0;">
              <button type="submit" class="btn <%= prod.status === 'active' ? 'btn-danger' : 'btn-primary' %> btn-sm">
                <%= prod.status === 'active' ? 'Delist Item' : 'Restore Listing' %>
              </button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<%- include('../partials/footer') %>
