<%- include('../partials/header') %>

<div style="max-width: 600px; margin: 4rem auto; text-align: center; background: #fff; padding: 3rem 2rem; border-radius: var(--radius); border: 1px solid var(--border); box-shadow: var(--shadow);">
  <div style="font-size: 3.5rem; margin-bottom: 1rem;">🔍</div>
  <h1 style="font-size: 2rem; font-weight: 800; color: var(--secondary); margin-bottom: 0.75rem;">404 — Page Not Found</h1>
  <p style="color: var(--text-muted); font-size: 1rem; margin-bottom: 2rem;">
    <%= typeof message !== 'undefined' ? message : 'The product, page, or resource you requested does not exist or may have been relocated.' %>
  </p>
  <a href="/" class="btn btn-primary">Return to Marketplace</a>
</div>

<%- include('../partials/footer') %>
