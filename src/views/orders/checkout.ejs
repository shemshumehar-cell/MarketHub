<%- include('../partials/header') %>

<div style="margin-bottom: 1.5rem;">
  <a href="/cart" style="font-size: 0.9rem; color: var(--text-muted);">← Return to cart</a>
</div>

<div style="display: flex; flex-direction: row; flex-wrap: wrap; gap: 2rem; align-items: flex-start;">
  <div class="card" style="flex: 2; min-width: 320px; padding: 2rem;">
    <h2 style="font-size: 1.5rem; font-weight: 700; margin-bottom: 0.5rem; color: var(--secondary);">
      Secure Checkout & Shipping Details
    </h2>
    <p style="color: var(--text-muted); font-size: 0.9rem; margin-bottom: 1.5rem;">
      Provide your fulfillment coordinates. All order transmissions are encrypted.
    </p>

    <form action="/orders/checkout" method="POST">
      <div class="form-group">
        <label class="form-label" for="shippingAddress">Delivery / Shipping Address</label>
        <textarea 
          id="shippingAddress" 
          name="shippingAddress" 
          rows="3" 
          class="form-control" 
          required 
          placeholder="e.g. 104 Cyber Tower, Block B, Hi-Tech City, Hyderabad, 500081"
        ></textarea>
        <div class="form-help">Physical address or secure delivery locker location.</div>
      </div>

      <div class="form-group">
        <label class="form-label">Mock Payment Gateway Method</label>
        <div style="display: flex; flex-direction: column; gap: 0.5rem; margin-top: 0.5rem;">
          <label style="display: flex; align-items: center; gap: 0.5rem; padding: 0.75rem; border: 1px solid var(--border); border-radius: var(--radius); cursor: pointer; background: #fff;">
            <input type="radio" name="payment_method" value="sandbox_card" checked>
            <span>💳 Instant Sandbox Credit Card (Pre-approved test token)</span>
          </label>
          <label style="display: flex; align-items: center; gap: 0.5rem; padding: 0.75rem; border: 1px solid var(--border); border-radius: var(--radius); cursor: pointer; background: #fff;">
            <input type="radio" name="payment_method" value="mock_crypto">
            <span>🪙 Mock Crypto Settlement (USDC On-chain Testnet)</span>
          </label>
        </div>
      </div>

      <div style="padding: 1rem; background-color: #f0fdf4; border: 1px solid #bbf7d0; border-radius: var(--radius); margin-bottom: 1.5rem; font-size: 0.85rem; color: #166534;">
        🛡️ <strong>Transactional Protection:</strong> Product inventory will be atomically locked and decremented upon order submission. No actual financial transactions are incurred during this hackathon demonstration.
      </div>

      <button type="submit" class="btn btn-primary" style="width: 100%; padding: 0.85rem; font-size: 1rem;">
        Authorize & Place Order ($<%= subtotal %>)
      </button>
    </form>
  </div>

  <!-- Items Summary -->
  <div class="card" style="flex: 1; min-width: 280px; padding: 1.5rem;">
    <h3 style="font-size: 1.2rem; font-weight: 700; margin-bottom: 1rem;">Cart Review (<%= items.length %> items)</h3>

    <div style="display: flex; flex-direction: column; gap: 0.75rem; margin-bottom: 1.25rem;">
      <% items.forEach(item => { %>
        <div style="display: flex; justify-content: space-between; font-size: 0.9rem;">
          <div>
            <div style="font-weight: 600; color: var(--secondary);"><%= item.title %></div>
            <div style="color: var(--text-muted); font-size: 0.8rem;">Qty: <%= item.quantity %> × $<%= Number(item.price).toFixed(2) %></div>
          </div>
          <div style="font-weight: 600;">$<%= (item.price * item.quantity).toFixed(2) %></div>
        </div>
      <% }) %>
    </div>

    <hr style="border: 0; border-top: 1px solid var(--border); margin-bottom: 1rem;">

    <div style="display: flex; justify-content: space-between; font-weight: 700; font-size: 1.15rem; color: var(--secondary);">
      <span>Total Amount</span>
      <span>$<%= subtotal %></span>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
