<%- include('../partials/header') %>

<div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 1.5rem;">
  <h1 style="font-size: 1.75rem; font-weight: 700;">My Order History</h1>
  <span style="color: var(--text-muted); font-size: 0.95rem;"><%= orders.length %> orders placed</span>
</div>

<% if (orders.length === 0) { %>
  <div style="text-align: center; padding: 4rem 1rem; background: #fff; border: 1px solid var(--border); border-radius: var(--radius);">
    <div style="font-size: 3rem; margin-bottom: 1rem;">📦</div>
    <h3 style="margin-bottom: 0.5rem;">No orders yet</h3>
    <p style="color: var(--text-muted); font-size: 0.9rem; margin-bottom: 1.5rem;">You haven't placed any marketplace orders yet.</p>
    <a href="/" class="btn btn-primary">Start Shopping</a>
  </div>
<% } else { %>
  <div class="table-responsive">
    <table>
      <thead>
        <tr>
          <th>Order #</th>
          <th>Placed On</th>
          <th>Items Count</th>
          <th>Total Amount</th>
          <th>Status</th>
          <th>Action</th>
        </tr>
      </thead>
      <tbody>
        <% orders.forEach(order => { %>
          <tr>
            <td style="font-weight: 600;">#ORD-<%= order.id %></td>
            <td><%= new Date(order.created_at).toLocaleString() %></td>
            <td><%= order.total_items %> items</td>
            <td style="font-weight: 700;">$<%= Number(order.total_amount).toFixed(2) %></td>
            <td>
              <span class="badge badge-<%= order.status %>"><%= order.status %></span>
            </td>
            <td>
              <a href="/orders/<%= order.id %>" class="btn btn-secondary btn-sm">View Receipt</a>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<% } %>

<%- include('../partials/footer') %>
