<%- include('../partials/header') %>

<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
  <div>
    <h1 style="font-size: 1.85rem; font-weight: 700;">Merchant Operations Center</h1>
    <p style="color: var(--text-muted); font-size: 0.95rem;">Manage your storefront, inventory, and track fulfillment.</p>
  </div>
  <div style="display: flex; gap: 0.75rem;">
    <a href="/vendor/orders" class="btn btn-secondary">📦 Vendor Orders</a>
    <a href="/vendor/products/new" class="btn btn-primary">+ Add New Product</a>
  </div>
</div>

<!-- Metrics Cards -->
<div class="stats-grid">
  <div class="stat-card">
    <div class="stat-title">Active Products</div>
    <div class="stat-value"><%= metrics.totalProducts %></div>
  </div>
  <div class="stat-card">
    <div class="stat-title">Units Sold</div>
    <div class="stat-value"><%= metrics.totalUnitsSold %></div>
  </div>
  <div class="stat-card">
    <div class="stat-title">Gross Revenue</div>
    <div class="stat-value" style="color: var(--accent);">$<%= metrics.totalRevenue %></div>
  </div>
  <div class="stat-card">
    <div class="stat-title">Low Stock Alerts</div>
    <div class="stat-value" style="color: <%= metrics.lowStockCount > 0 ? 'var(--danger)' : 'var(--text-muted)' %>;">
      <%= metrics.lowStockCount %>
    </div>
  </div>
</div>

<% if (lowStockItems.length > 0) { %>
  <div class="alert alert-error">
    <span>⚠️ <strong>Low Stock Warning:</strong> <%= lowStockItems.length %> of your products have fewer than 5 units remaining in inventory.</span>
  </div>
<% } %>

<h2 style="font-size: 1.35rem; font-weight: 700; margin-bottom: 1rem;">Your Product Catalog</h2>

<% if (products.length === 0) { %>
  <div style="text-align: center; padding: 4rem 1rem; background: #fff; border: 1px solid var(--border); border-radius: var(--radius);">
    <h3>You have not listed any products yet</h3>
    <p style="color: var(--text-muted); font-size: 0.9rem; margin-bottom: 1.5rem;">Start selling by publishing your first product to MarketHub.</p>
    <a href="/vendor/products/new" class="btn btn-primary">+ Add Product</a>
  </div>
<% } else { %>
  <div class="table-responsive">
    <table>
      <thead>
        <tr>
          <th>Product</th>
          <th>Category</th>
          <th>Price</th>
          <th>Stock</th>
          <th>Status</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% products.forEach(prod => { %>
          <tr>
            <td>
              <div style="display: flex; align-items: center; gap: 0.75rem;">
                <img src="<%= prod.image_url || '/images/placeholder.svg' %>" alt="<%= prod.title %>" style="width: 44px; height: 44px; object-fit: cover; border-radius: 4px; background: #f1f5f9;">
                <div>
                  <a href="/products/<%= prod.id %>" style="font-weight: 600; color: var(--secondary);">
                    <%= prod.title %>
                  </a>
                  <div style="font-size: 0.75rem; color: var(--text-muted);">ID: #<%= prod.id %></div>
                </div>
              </div>
            </td>
            <td><%= prod.category_name || 'General' %></td>
            <td style="font-weight: 700;">$<%= Number(prod.price).toFixed(2) %></td>
            <td>
              <span style="font-weight: 600; color: <%= prod.stock < 5 ? 'var(--danger)' : 'inherit' %>;">
                <%= prod.stock %> units
              </span>
            </td>
            <td>
              <span class="badge badge-<%= prod.status %>"><%= prod.status %></span>
            </td>
            <td>
              <div style="display: flex; gap: 0.5rem;">
                <a href="/vendor/products/<%= prod.id %>/edit" class="btn btn-secondary btn-sm">Edit</a>
                <form action="/vendor/products/<%= prod.id %>/delete" method="POST" style="margin: 0;" onsubmit="return confirm('Are you sure you want to delete this product?');">
                  <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                </form>
              </div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<% } %>

<%- include('../partials/footer') %>
