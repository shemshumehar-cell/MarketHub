<%- include('../partials/header') %>

<div style="margin-bottom: 1.5rem;">
  <a href="/vendor" style="font-size: 0.9rem; color: var(--text-muted);">← Back to vendor dashboard</a>
</div>

<div class="card" style="max-width: 680px; margin: 0 auto; padding: 2.5rem;">
  <h2 style="font-size: 1.6rem; font-weight: 700; margin-bottom: 0.5rem; color: var(--secondary);">
    <%= isEdit ? 'Edit Product Listing' : 'Publish New Product Listing' %>
  </h2>
  <p style="color: var(--text-muted); font-size: 0.9rem; margin-bottom: 2rem;">
    All submissions are validated and logged for security compliance.
  </p>

  <form action="<%= isEdit ? '/vendor/products/' + product.id + '/edit' : '/vendor/products/new' %>" method="POST" enctype="multipart/form-data">
    <div class="form-group">
      <label class="form-label" for="title">Product Title</label>
      <input 
        type="text" 
        id="title" 
        name="title" 
        class="form-control" 
        required 
        value="<%= product ? product.title : '' %>"
        placeholder="e.g. Encrypted Hardware Storage Drive"
      >
    </div>

    <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
      <div class="form-group" style="flex: 1; min-width: 200px;">
        <label class="form-label" for="category_id">Category</label>
        <select id="category_id" name="category_id" class="form-control" required>
          <% categories.forEach(cat => { %>
            <option value="<%= cat.id %>" <%= product && product.category_id === cat.id ? 'selected' : '' %>>
              <%= cat.name %>
            </option>
          <% }) %>
        </select>
      </div>

      <div class="form-group" style="flex: 1; min-width: 140px;">
        <label class="form-label" for="price">Unit Price ($ USD)</label>
        <input 
          type="number" 
          id="price" 
          name="price" 
          step="0.01" 
          min="0.01" 
          class="form-control" 
          required 
          value="<%= product ? product.price : '' %>"
          placeholder="49.99"
        >
      </div>

      <div class="form-group" style="flex: 1; min-width: 140px;">
        <label class="form-label" for="stock">Available Stock</label>
        <input 
          type="number" 
          id="stock" 
          name="stock" 
          min="0" 
          class="form-control" 
          required 
          value="<%= product ? product.stock : '10' %>"
          placeholder="10"
        >
      </div>
    </div>

    <div class="form-group">
      <label class="form-label" for="description">Detailed Description</label>
      <textarea 
        id="description" 
        name="description" 
        rows="4" 
        class="form-control" 
        placeholder="Provide technical specs, certifications, and product warranty..."
      ><%= product ? product.description : '' %></textarea>
    </div>

    <div class="form-group">
      <label class="form-label" for="image">Product Image (JPG, PNG, or WEBP - Max 2MB)</label>
      <input type="file" id="image" name="image" class="form-control" accept=".jpg,.jpeg,.png,.webp">
      <% if (product && product.image_url) { %>
        <div style="margin-top: 0.5rem; display: flex; align-items: center; gap: 0.5rem;">
          <span style="font-size: 0.8rem; color: var(--text-muted);">Current image:</span>
          <img src="<%= product.image_url %>" alt="Current" style="height: 32px; border-radius: 4px; border: 1px solid var(--border);">
        </div>
      <% } %>
      <div class="form-help">Uploaded images are cryptographically renamed and scanned for filetype safety.</div>
    </div>

    <% if (isEdit) { %>
      <div class="form-group">
        <label class="form-label" for="status">Listing Status</label>
        <select id="status" name="status" class="form-control">
          <option value="active" <%= product.status === 'active' ? 'selected' : '' %>>Active (Visible on marketplace)</option>
          <option value="inactive" <%= product.status === 'inactive' ? 'selected' : '' %>>Inactive (Hidden from public)</option>
        </select>
      </div>
    <% } %>

    <div style="display: flex; gap: 1rem; margin-top: 2rem;">
      <button type="submit" class="btn btn-primary" style="flex: 1; padding: 0.75rem;">
        <%= isEdit ? 'Save Changes' : 'Publish Product to Marketplace' %>
      </button>
      <a href="/vendor" class="btn btn-secondary" style="padding: 0.75rem 1.5rem;">Cancel</a>
    </div>
  </form>
</div>

<%- include('../partials/footer') %>
